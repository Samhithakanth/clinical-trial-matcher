DB_HOST=localhost
DB_PORT=3306
DB_USER=clinician_app
DB_PASSWORD=replace_with_your_password
DB_NAME=clinical_trial_matcher

# Signs login session cookies. Use a long random value (at least 32 chars),
# different on every machine. Generate one in PowerShell:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everyone out.
SESSION_SECRET=replace_with_a_long_random_secret

# Embeddings: "transformers" (local all-MiniLM-L6-v2, default) or "hash"
# (offline keyword-hashing fallback, lexical not semantic)
EMBEDDING_PROVIDER=transformers
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# Only needed if your column names differ (check DESCRIBE clinical_notes;)
# NOTES_ID_COLUMN=note_id
# NOTES_SUBJECT_COLUMN=subject_id
# NOTES_TEXT_COLUMN=note_text
# CRITERION_TRIAL_COLUMN=trial_id
# CRITERION_TEXT_COLUMN=criterion_text
# CRITERION_TYPE_COLUMN=criterion_type
# CRITERION_INCLUSION_VALUE=INCLUSION
